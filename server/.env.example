PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/evalengine
JWT_SECRET=evalengine_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: override Python binary path if not on PATH
# PYTHON_PATH=
# Fallback to local embedded MongoDB (mongodb-memory-server) when MONGODB_URI is unreachable in development
USE_MEMORY_DB_FALLBACK=true
